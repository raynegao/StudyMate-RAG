# Required for DeepSeek chat completion calls.
# If your local file still uses OPENAI_API_KEY for a DeepSeek key, the app also accepts that name.
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# App and frontend defaults.
STUDYMATE_APP_NAME=StudyMate RAG API
STUDYMATE_APP_VERSION=0.2.0
STUDYMATE_LOG_LEVEL=INFO
STUDYMATE_API_BASE_URL=http://127.0.0.1:8000
STUDYMATE_FRONTEND_TIMEOUT=60
STUDYMATE_BACKEND_HOST=127.0.0.1
STUDYMATE_BACKEND_PORT=8000
STUDYMATE_FRONTEND_HOST=127.0.0.1
STUDYMATE_FRONTEND_PORT=8501

# Local storage paths.
STUDYMATE_UPLOAD_DIR=data/uploads
STUDYMATE_CHROMA_DIR=data/chroma_db
STUDYMATE_CHROMA_COLLECTION=studymate_documents

# Model and RAG defaults.
STUDYMATE_LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# Optional. Use cpu, mps, or cuda when you want to force a specific device.
STUDYMATE_EMBEDDING_DEVICE=
STUDYMATE_LLM_MODEL=deepseek-v4-flash
STUDYMATE_LLM_TEMPERATURE=0.0
STUDYMATE_CHUNK_SIZE=1000
STUDYMATE_CHUNK_OVERLAP=150
STUDYMATE_TOP_K=4
STUDYMATE_EMBEDDING_BATCH_SIZE=64
STUDYMATE_MAX_UPLOAD_SIZE_MB=25
