{
  "name": "StudyMate RAG Public Hard Chinese Benchmark",
  "version": "1.0.0",
  "description": "Harder fictional questions over extended copies of the public PDFs. Each hard PDF keeps the original pages 2-4 unchanged and adds a page of confusable entities and procedures. Questions were fixed before the first evaluation run.",
  "question_types": {
    "paraphrase": "No named entity from the source; wording differs from the source text.",
    "distractor": "A confusable entity with different values exists in the same document.",
    "boundary": "Asks about an edge value or condition stated by a rule.",
    "multi_page": "Needs evidence from more than one page; every evidence group must be retrieved."
  },
  "documents": [
    {
      "filename": "studymate-hard-observatory.pdf",
      "base_document": "studymate-eval-observatory.pdf",
      "title": "极光观测站操作基础（加难版）",
      "subtitle": "公开虚构评测资料 A-H",
      "extra_pages": [
        {
          "heading": "相近设备与例外规程",
          "sections": [
            {
              "title": "琥珀校准牌",
              "text": "琥珀校准牌用于标记已经通过增益校准的传感器。校准牌的激活窗口为 28 分钟，超过窗口后必须重新执行增益校准。与零点校准使用的标记不同，琥珀校准牌可以在同一观测轮次内转移给备用设备。"
            },
            {
              "title": "天底脉冲采样",
              "text": "天底脉冲采样必须包含连续 9 次测量，相邻两次测量的间隔不得超过 6 秒。天底采样只用于地面反射校正，不能替代天顶脉冲采样。"
            },
            {
              "title": "副镜冷启动",
              "text": "副镜完成冷启动后预热 6 分钟即可用于对焦测试，但正式观测仍以主镜预热完成为准。副镜预热期间同样不得写入正式观测记录。"
            },
            {
              "title": "西塔同步计划",
              "text": "西塔每天在协调世界时 14:30 执行一次增量同步。增量同步生成的审计记录保留 30 天，到期后由归档服务批量移除。"
            },
            {
              "title": "夜间巡检流程",
              "text": "夜间巡检开始时，先等待主镜冷启动预热结束，再执行一次天顶脉冲采样。只有这组采样判定有效后，值班人员才可以写入当晚第一条正式观测记录。"
            }
          ]
        }
      ]
    },
    {
      "filename": "studymate-hard-ecology.pdf",
      "base_document": "studymate-eval-ecology.pdf",
      "title": "封闭生态舱维护手册（加难版）",
      "subtitle": "公开虚构评测资料 B-H",
      "extra_pages": [
        {
          "heading": "相近物种与例外规程",
          "sections": [
            {
              "title": "银苔灌溉",
              "text": "银苔每 4 天灌溉一次，每平方米使用 2.6 升循环水，灌溉当天保持 7 小时紫光照明。银苔与琥珀苔种植在同一舱段，但两者不能共用灌溉计划。"
            },
            {
              "title": "雾培育苗间",
              "text": "雾培育苗间只用于播种后前两周的幼苗，相对湿度保持在 80% 到 86%，标准温度为 24 摄氏度。幼苗移出后执行普通雾培温室的环境标准。"
            },
            {
              "title": "金翅雀声学信标",
              "text": "金翅雀佩戴的声学信标工作频率为 38 kHz，在无遮挡环境中的标称检测半径为 90 米。金翅雀信标与银翅雀信标不能使用同一接收器。"
            },
            {
              "title": "蓝色样本瓶盖",
              "text": "蓝色样本瓶盖只用于无菌样本，最多使用 3 次。蓝色瓶盖不得与绿色瓶盖混放在同一清洗篮中。"
            },
            {
              "title": "季度巡检流程",
              "text": "季度巡检先确认授粉走廊的净宽度没有低于下限，再测试二氧化碳应急通风阀能否在规定浓度自动开启，最后抽查一次营养液配比。"
            }
          ]
        }
      ]
    },
    {
      "filename": "studymate-hard-computing.pdf",
      "base_document": "studymate-eval-computing.pdf",
      "title": "棱镜计算平台运行规范（加难版）",
      "subtitle": "公开虚构评测资料 C-H",
      "extra_pages": [
        {
          "heading": "相近组件与例外规程",
          "sections": [
            {
              "title": "信标调度器",
              "text": "信标调度器只服务批处理队列，默认时间片是 40 毫秒。批处理的高优先级队列与普通队列按照 2:1 的次数比例获得执行机会。"
            },
            {
              "title": "珊瑚缓存",
              "text": "珊瑚缓存条目的默认生存时间是 180 秒。与珍珠缓存不同，珊瑚缓存的读取命中会让生存时间重新计时。"
            },
            {
              "title": "绿色沙箱",
              "text": "绿色沙箱专门运行不可信代码，单个绿色沙箱最多同时运行 6 个作业。超出的作业会被直接拒绝，而不是进入等待队列。"
            },
            {
              "title": "存储写入重试",
              "text": "存储写入请求最多重试 2 次，相邻重试之间固定等待 1 秒。存储写入的重试规则与网络请求的重试规则相互独立。"
            },
            {
              "title": "发布前检查流程",
              "text": "版本发布前先确认最近一次运行状态快照已经写入索引，再核对恢复点目标允许丢失的事务上限，最后确认审计日志仍处于在线保留期内。"
            }
          ]
        }
      ]
    }
  ],
